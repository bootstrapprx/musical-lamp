{
  "name": "frappe-deployer-gui",
  "version": "0.1.0",
  "private": true,
  "description": "GUI desktop para o frappe-deployer TUI",
  "author": "bootstrapprx",
  "repository": "https://github.com/bootstrapprx/musical-lamp.git",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "VITE_DEV_SERVER_URL=http://127.0.0.1:5173 concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.bootstrapprx.frappe-deployer",
    "productName": "Frappe Deployer",
    "linux": {
      "category": "Utility",
      "target": ["AppImage"]
    }
  }
}
