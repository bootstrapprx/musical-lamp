# Copie para .env e preencha. chmod 600 .env. Nunca versione o .env.

# --- Imagem -------------------------------------------------------------------
# Em producao use o DIGEST: kodoo/accounting@sha256:...
IMAGE_REF=kodoo/accounting:RELEASE
PULL_POLICY=missing

# --- Banco / cache ------------------------------------------------------------
# Gere com: openssl rand -hex 24
DB_PASSWORD=
MARIADB_IMAGE=mariadb:11.8
# Fixe tag (ou digest) em producao.
REDIS_IMAGE=redis:8-alpine

# --- Frappe -------------------------------------------------------------------
# Vazio = multi-tenant (site escolhido pelo Host). Preenchido = single-site.
FRAPPE_SITE_NAME_HEADER=
CLIENT_MAX_BODY_SIZE=50m
# Caminho do Chromium dentro da imagem (confirme: dpkg -L chromium-headless-shell).
# Vazio = nao configura.
CHROMIUM_PATH=

# --- Cloudflare Tunnel (um conector por produto) ------------------------------
TUNNEL_TOKEN=
# Obrigatorio fixar a tag.
CLOUDFLARED_VERSION=
# Rede de borda exclusiva (cloudflared + frontend). Nao pode colidir entre produtos.
EDGE_SUBNET=172.30.2.0/28
# Faixa de IPs dinamicos (metade superior da sub-rede); deve NAO conter o CLOUDFLARED_IP.
EDGE_IP_RANGE=172.30.2.8/29
# IP fixo do cloudflared nessa rede; e o unico em que o nginx confia para CF-Connecting-IP.
CLOUDFLARED_IP=172.30.2.2
