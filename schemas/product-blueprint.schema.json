{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musical-lamp.invalid/schemas/product-blueprint.schema.json",
  "title": "Musical Lamp Product Blueprint",
  "type": "object",
  "required": ["api_version", "kind", "metadata", "framework", "apps", "sites", "runtime", "secrets"],
  "properties": {
    "api_version": {"const": "musical-lamp/v1"},
    "kind": {"const": "ProductBlueprint"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "framework": {"type": "object", "required": ["app"], "properties": {"app": {"$ref": "#/$defs/id"}}, "additionalProperties": false},
    "apps": {"type": "array", "items": {"$ref": "#/$defs/app_selection"}, "uniqueItems": true},
    "sites": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/site"}},
    "runtime": {"$ref": "#/$defs/runtime"},
    "network": {"type": "object", "additionalProperties": true},
    "secrets": {"type": "array", "items": {"$ref": "#/$defs/secret_ref"}, "uniqueItems": true},
    "deployment": {"type": "object", "properties": {"require_approval": {"type": "boolean"}, "backup_before_migrate": {"type": "boolean"}}, "additionalProperties": true}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "metadata": {"type": "object", "required": ["id", "name", "revision"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "app_selection": {"type": "object", "required": ["app"], "properties": {"app": {"$ref": "#/$defs/id"}, "configuration": {"type": "object", "additionalProperties": true}}, "additionalProperties": false},
    "site": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}, "host_name": {"type": "string", "format": "uri"}, "configuration": {"type": "object", "additionalProperties": true}}, "additionalProperties": false},
    "runtime": {"type": "object", "required": ["image", "database", "cache"], "properties": {"image": {"type": "object", "required": ["policy", "repository"], "properties": {"policy": {"enum": ["build", "pull"]}, "repository": {"type": "string", "minLength": 1}, "reference": {"type": "string"}}, "additionalProperties": false}, "database": {"type": "object", "required": ["engine", "image"], "properties": {"engine": {"const": "mariadb"}, "image": {"type": "string", "minLength": 1}}, "additionalProperties": false}, "cache": {"type": "object", "required": ["engine", "image"], "properties": {"engine": {"const": "redis"}, "image": {"type": "string", "minLength": 1}}, "additionalProperties": false}}, "additionalProperties": false},
    "secret_ref": {"type": "object", "required": ["ref"], "properties": {"ref": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
